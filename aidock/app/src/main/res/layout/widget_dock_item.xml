<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/item"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:gravity="center_horizontal" android:paddingTop="4dp" android:paddingBottom="2dp">
    <ImageView android:id="@+id/icon" android:layout_width="44dp" android:layout_height="44dp" />
    <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textColor="@color/text" android:textSize="11sp" android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
